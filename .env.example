# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN — DESPACHA FÁCIL API (.env.example)
# ==============================================================================

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/despachafacil
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

PORT=8080

JWT_SECRET=your_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

SPRING_PROFILES_ACTIVE=local

# ==============================================================================
# ALMACENAMIENTO CLOUDFLARE R2 (10GB GRATIS - ZERO EGRESS FEES)
# ==============================================================================
CLOUDFLARE_R2_ACCOUNT_ID=tu_account_id_de_cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=tu_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=despacha-facil-storage
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
